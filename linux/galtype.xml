<?xml version="1.0" encoding="utf-8"?>
<!-- Galtype の IBus のコンポーネント。install.sh が @DIR@ をインストール先に置き換えて /usr/share/ibus/component に入れる。 -->
<component>
    <name>org.freedesktop.IBus.Galtype</name>
    <description>Galtype: 半角/全角 を押さずに日本語と英語を打ち分ける日本語入力</description>
    <exec>@DIR@/ibus-engine-galtype --ibus</exec>
    <version>1.0.0</version>
    <author>oto-lab (based on Meltype by Yukishiro)</author>
    <license>GPL-3.0-or-later</license>
    <homepage>https://github.com/oto-lab/Galtype</homepage>
    <textdomain>galtype</textdomain>
    <engines>
        <engine>
            <name>galtype</name>
            <language>ja</language>
            <license>GPL-3.0-or-later</license>
            <author>oto-lab (based on Meltype by Yukishiro)</author>
            <icon>@DIR@/icon.png</icon>
            <layout>default</layout>
            <longname>Galtype</longname>
            <description>半角/全角 を押さずに日本語と英語を打ち分ける日本語入力</description>
            <rank>0</rank>
            <symbol>あ</symbol>
        </engine>
    </engines>
</component>
